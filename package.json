{
  "name": "identark",
  "version": "1.0.2",
  "description": "The AgentGateway Protocol — secure, scalable agent execution infrastructure",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/identArk/identark-js.git"
  },
  "homepage": "https://github.com/identArk/identark-js#readme",
  "bugs": {
    "url": "https://github.com/identArk/identark-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integrations/langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js"
    },
    "./integrations/vercel": {
      "types": "./dist/integrations/vercel.d.ts",
      "import": "./dist/integrations/vercel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "dev": "tsc --watch",
    "version": "node scripts/sync-version.mjs && git add src/index.ts"
  },
  "keywords": [
    "identark",
    "agent",
    "gateway",
    "llm",
    "ai",
    "sdk"
  ],
  "author": "Gold Okpa",
  "license": "MIT",
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "openai": "^4.0.0 || ^5.0.0",
    "@langchain/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.2.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
